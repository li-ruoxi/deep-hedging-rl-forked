   "source": [
    "## 1. Data Acquisition (Yahoo Finance)\n",
    "We download `SPY`, `^VIX`, and `^TNX` and prepare a training CSV."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d9cf01af",
   "metadata": {},
   "outputs": [],
   "source": [
    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def prepare_yahoo_data(output_path):\n",
    "    # 1. Download\n",
    "    tickers = [\"SPY\", \"^VIX\", \"^TNX\"]\n",
    "    data = yf.download(tickers, start=\"2010-01-01\", end=\"2024-04-01\", auto_adjust=True)\n",
    "    \n",
    "    # 2. Extract Close and Volume\n",
    "    df_close = data['Close'].rename(columns={\"SPY\": \"close_spy\", \"^VIX\": \"vix\", \"^TNX\": \"rate_10y\"})\n",
    "    df_vol = data['Volume'][['SPY']].rename(columns={\"SPY\": \"volume_spy\"})\n",
    "    \n",
    "    df = pd.concat([df_close, df_vol], axis=1).ffill().dropna().reset_index()\n",
    "    df.rename(columns={'Date': 'date'}, inplace=True)\n",
    "    df['date'] = pd.to_datetime(df['date']).dt.strftime('%Y-%m-%d')\n",
    "    \n",
    "    # 3. Feature Engineering\n",
    "    df['spy_ret'] = df['close_spy'].pct_change()\n",
    "    df['spy_ret_lag1'] = df['spy_ret'].shift(1)\n",
    "    df['spy_ret_lag5'] = df['close_spy'].pct_change(5).shift(1)\n",
    "    df['volume_spy'] = np.log1p(df['volume_spy'])\n",
    "    \n",
    "    def calc_rv(window):\n",
    "        return df['spy_ret'].rolling(window).std() * np.sqrt(252)\n",
    "\n",
    "    df['rv_5d'] = calc_rv(5)\n",
    "    df['rv_10d'] = calc_rv(10)\n",
    "    df['rv_20d'] = calc_rv(20)\n",
    "    df['rv_60d'] = calc_rv(60)\n",
    "    df['ret_fwd'] = df['spy_ret'].shift(-1)\n",
    "    \n",
    "    df = df.dropna().reset_index(drop=True)\n",
    "    df.to_csv(output_path, index=False)\n",
    "    return df\n"
   ]
  },
