    "from rl_agent.train_ac_gae import train as train_gae\n",
    "\n",
    "# Load data\n",
    "data_path = REPO_ROOT / \"data/processed/cleaned/yahoo_v3_10feats.csv\"\n",
    "if not data_path.exists():\n",
    "    print(\"Preparing data...\")\n",
    "    prepare_yahoo_data(data_path)\n",
    "\n",
    "panel = pd.read_csv(data_path)\n",
    "\n",
    "# Run training\n",
    "policy, metrics, history = train_gae(\n",
    "    panel=panel,\n",
    "    state_cols=[\n",
    "        'close_spy', 'vix', 'rate_10y', 'volume_spy',\n",
    "        'rv_5d', 'rv_10d', 'rv_20d', 'rv_60d',\n",
    "        'spy_ret_lag1', 'spy_ret_lag5'\n",
    "    ],\n",
    "    window=30,\n",
    "    hidden=64,\n",
    "    steps=2000,\n",
    "    slippage_bps=8.0,\n",
    "    txn_cost_bps=1.0,\n",
    "    save_outdir=str(REPO_ROOT / \"models/scaled_down_v2\"),\n",
    "    save_ckpt=str(REPO_ROOT / \"models/scaled_down_v2/best.pt\"),\n",
    "    track_history=True\n",
    ")"
   ]
  },
